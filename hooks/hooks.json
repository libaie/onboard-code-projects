{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dispatch-return-runtime.mjs\" capture-stop",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\dispatch-return-runtime.mjs\" capture-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
